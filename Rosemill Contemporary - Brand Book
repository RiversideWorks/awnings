<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Rosemill Contemporary – Brand Book</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;1,400&family=Inter:wght@300;500&display=swap" rel="stylesheet">
<style>
:root{--bg:#e9e4da;--ink:#1b1a18;--mute:#6f6a60;--line:rgba(27,26,24,.22);--accent:#9a6b3f;--glow:rgba(154,107,63,.18);
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#141311;--ink:#ece7dc;--mute:#9b9488;--line:rgba(236,231,220,.22);--accent:#c99a64;--glow:rgba(201,154,100,.14)}}
:root[data-theme="dark"]{--bg:#141311;--ink:#ece7dc;--mute:#9b9488;--line:rgba(236,231,220,.22);--accent:#c99a64;--glow:rgba(201,154,100,.14)}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{background:radial-gradient(ellipse at 50% 45%,var(--glow),transparent 62%),var(--bg);color:var(--ink);font-family:Inter,system-ui,sans-serif;font-weight:300;display:flex;flex-direction:column;overflow:hidden}
header,footer{display:flex;justify-content:space-between;align-items:center;padding:18px clamp(16px,4vw,48px);font-size:11px;letter-spacing:.28em;text-transform:uppercase}
header b{font-weight:500}
header span,footer a{color:var(--mute);text-decoration:none}
footer a:hover{color:var(--accent)}
main{flex:1;display:flex;align-items:center;justify-content:center;min-height:0;position:relative}
#book{width:min(94vw,calc((100svh - 190px)*2.83));aspect-ratio:2.83/1;filter:drop-shadow(0 30px 40px rgba(0,0,0,.28))}
@media (max-width:600px){#book{width:96vw;aspect-ratio:1.415/1}}
.nav{position:absolute;top:50%;transform:translateY(-50%);width:46px;height:46px;border-radius:50%;border:1px solid var(--line);background:transparent;color:var(--ink);cursor:pointer;font-size:18px;transition:.25s;z-index:5}
.nav:hover{background:var(--ink);color:var(--bg)}
#prev{left:clamp(6px,2vw,28px)}#next{right:clamp(6px,2vw,28px)}
#hint{position:absolute;bottom:6px;font-family:'Cormorant Garamond',Georgia,serif;font-style:italic;font-size:18px;color:var(--mute);transition:opacity .6s;pointer-events:none}
footer{gap:16px}
#bar{flex:1;max-width:260px;height:1px;background:var(--line);position:relative}
#bar i{position:absolute;left:0;top:-1px;height:3px;background:var(--accent);width:0;transition:width .5s}
#count{font-variant-numeric:tabular-nums;min-width:70px}
.tools{display:flex;gap:18px;align-items:center}
button.t{background:none;border:0;color:var(--mute);font:inherit;letter-spacing:inherit;text-transform:inherit;cursor:pointer;padding:0}
button.t:hover{color:var(--accent)}
@media (max-width:600px){.nav{display:none}header span{display:none}}
</style>
</head>
<body>
<header><b>Rosemill Contemporary</b><span>Brand Book</span></header>
<main>
<button class="nav" id="prev" aria-label="Previous page">←</button>
<div id="book"></div>
<button class="nav" id="next" aria-label="Next page">→</button>
<div id="hint">Drag a corner, tap an arrow or use ← → to turn the page</div>
</main>
<footer>
<span id="count">01 / 05</span>
<div id="bar"><i></i></div>
<div class="tools"><button class="t" id="fs">Full screen</button><a href="https://rosemillcontemporary.co.uk" target="_blank" rel="noopener">Enquire ↗</a></div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/page-flip@2.0.7/dist/js/page-flip.browser.js"></script>
<script>
const PAGES=["data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,"];
const pf=new St.PageFlip(document.getElementById('book'),{width:1000,height:707,size:'stretch',minWidth:260,maxWidth:1800,minHeight:180,maxHeight:1300,showCover:true,maxShadowOpacity:.45,flippingTime:900,drawShadow:true,mobileScrollSupport:false,usePortrait:true});
pf.loadFromImages(PAGES);
const n=PAGES.length,cnt=document.getElementById('count'),bar=document.querySelector('#bar i'),hint=document.getElementById('hint');
const pad=x=>String(x).padStart(2,'0');
function upd(){const i=pf.getCurrentPageIndex();cnt.textContent=pad(i+1)+' / '+pad(n);bar.style.width=((i+1)/n*100)+'%'}
pf.on('flip',()=>{upd();hint.style.opacity=0});
upd();
document.getElementById('prev').onclick=()=>pf.flipPrev();
document.getElementById('next').onclick=()=>pf.flipNext();
addEventListener('keydown',e=>{if(e.key==='ArrowRight')pf.flipNext();if(e.key==='ArrowLeft')pf.flipPrev()});
document.getElementById('fs').onclick=()=>{try{document.fullscreenElement?document.exitFullscreen():document.documentElement.requestFullscreen()}catch(e){}};
</script>
</body>
</html>
